# Copy to .env and fill in. Keep values on their own line (no inline comments).
WANDB_API_KEY=
# Optional: your W&B team/user. Needed if your account has no default entity.
WANDB_ENTITY=
WANDB_INFERENCE_BASE_URL=https://api.inference.wandb.ai/v1
# TypeSafe AI System One. Only the key is required (SDK defaults: https://api.typesafe.ai, jev-latest).
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=
TYPESAFE_MODEL=
